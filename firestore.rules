rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.ownerIds;
    }

    function isAdoptionRequestParty(data) {
      return signedIn() &&
        (data.ownerId == request.auth.uid ||
         data.applicantId == request.auth.uid);
    }

    function isApprovedAdoptionPartyForPet(petData) {
      return signedIn() &&
        petData.approvedRequestId is string &&
        exists(/databases/$(database)/documents/adoptionRequests/$(petData.approvedRequestId)) &&
        isAdoptionRequestParty(
          get(/databases/$(database)/documents/adoptionRequests/$(petData.approvedRequestId)).data
        );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['listing', 'user'];
      allow read: if isAdmin() ||
        (signedIn() &&
          (reportId.matches('.*_' + request.auth.uid) ||
           resource.data.reporterId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /adoptionReturnRequests/{returnRequestId} {
      allow create: if signedIn() &&
        request.resource.data.filedBy == request.auth.uid &&
        request.resource.data.conversationId is string &&
        request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
            .data.participantIds;
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.filedBy == request.auth.uid ||
           resource.data.ownerId == request.auth.uid));
      allow update: if isAdmin() ||
        (signedIn() &&
          request.auth.uid in resource.data.participantIds &&
          resource.data.adminStatus == 'approved' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['handoverConfirmations', 'status', 'completedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /returnedPets/{returnedPetId} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.status == 'completed' &&
        getAfter(
          /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
        ).data.status == 'returned';
      allow update, delete: if isAdmin();
    }

    match /adminActivity/{activityId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /pets/{petId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
      allow update: if isApprovedAdoptionPartyForPet(resource.data) &&
        resource.data.adoptionStatus == 'reserved' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'ownerId',
            'ownerName',
            'ownerPhoto',
            'previousOwnerId',
            'previousOwnerName',
            'previousOwnerPhoto',
            'adoptedBy',
            'adoptionRequestId',
            'adoptionConversationId',
            'status',
            'adoptionStatus',
            'isActive',
            'adoptedAt',
            'updatedAt'
          ]) &&
        request.resource.data.ownerId ==
          get(/databases/$(database)/documents/adoptionRequests/$(resource.data.approvedRequestId))
            .data.applicantId &&
        request.resource.data.previousOwnerId == resource.data.ownerId &&
        request.resource.data.adoptedBy ==
          get(/databases/$(database)/documents/adoptionRequests/$(resource.data.approvedRequestId))
            .data.applicantId &&
        request.resource.data.adoptionRequestId == resource.data.approvedRequestId &&
        request.resource.data.status == 'adopted' &&
        request.resource.data.adoptionStatus == 'adopted' &&
        request.resource.data.isActive == false;
      allow update: if isApprovedAdoptionPartyForPet(resource.data) &&
        request.resource.data.ownerId ==
          get(/databases/$(database)/documents/adoptionRequests/$(resource.data.approvedRequestId))
            .data.ownerId &&
        request.resource.data.status == 'unpublished' &&
        request.resource.data.adoptionStatus == 'returned' &&
        request.resource.data.isActive == false &&
        request.resource.data.returnedFromConversationId is string &&
        getAfter(
          /databases/$(database)/documents/conversations/$(request.resource.data.returnedFromConversationId)
        ).data.status == 'returned';
      allow delete: if signedIn() &&
        resource.data.ownerId == request.auth.uid;
    }

    match /petPublicationKeys/{publicationKeyId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
    }

    match /swipes/{swipeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if isParticipant(request.resource.data);
      allow update: if isParticipant(resource.data) &&
        request.resource.data.ownerIds == resource.data.ownerIds &&
        request.resource.data.petIds == resource.data.petIds &&
        !(resource.data.status == 'completed' &&
          request.resource.data.status == 'unmatched');
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          request.auth.uid in resource.data.participantIds);
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        (
          request.resource.data.purpose == 'breeding' ||
          (
            request.resource.data.purpose == 'adoption' &&
            request.resource.data.requestId is string &&
            getAfter(
              /databases/$(database)/documents/adoptionRequests/$(request.resource.data.requestId)
            ).data.status == 'approved' &&
            getAfter(
              /databases/$(database)/documents/adoptionRequests/$(request.resource.data.requestId)
            ).data.ownerId == request.auth.uid
          )
        );
      allow update: if isAdmin() ||
        (signedIn() &&
          request.auth.uid in resource.data.participantIds &&
          request.resource.data.participantIds == resource.data.participantIds &&
          !(resource.data.status == 'completed' &&
            request.resource.data.status == 'unmatched'));

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantIds);
        allow create: if isAdmin() ||
          (signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          (
            !request.resource.data.keys().hasAny(['mediaType']) ||
            (
              request.resource.data.type == 'media' &&
              request.resource.data.mediaType in ['image', 'video'] &&
              request.resource.data.mediaUrl is string &&
              request.resource.data.mediaUrl.size() > 0 &&
              request.resource.data.mediaSizeBytes is int &&
              request.resource.data.mediaSizeBytes >= 0 &&
              (
                request.resource.data.mediaType != 'video' ||
                request.resource.data.mediaSizeBytes <= 52428800
              )
            )
          ) &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds &&
          get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.status != 'unmatched' &&
          (
            (
              get(/databases/$(database)/documents/conversations/$(conversationId))
                  .data.purpose == 'adoption' &&
              (
                get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.get('canSendMessages', true) != false ||
                get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.status == 'completed'
              ) &&
              get(/databases/$(database)/documents/conversations/$(conversationId))
                  .data.get('adoptionProcess', {}).get('status', 'not_started')
                    != 'contract_pending'
            ) ||
            (
              get(/databases/$(database)/documents/conversations/$(conversationId))
                  .data.purpose == 'breeding' &&
              (
                get(/databases/$(database)/documents/matches/$(conversationId))
                    .data.status != 'completed' ||
                request.time <
                  get(/databases/$(database)/documents/matches/$(conversationId))
                    .data.reviewReleaseAt
              )
            )
          ));
        allow update: if signedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy', 'requestStatus', 'updatedAt']);
      }

      match /adoptionUpdateRequests/{updateRequestId} {
        allow read, create, update: if isAdmin() ||
          (signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantIds);
      }

      match /adoptionReturnRequests/{returnRequestId} {
        allow read, create, update: if isAdmin() ||
          (signedIn() &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.participantIds);
      }
    }

    match /favorites/{favoriteId} {
      allow get: if signedIn() &&
        (
          favoriteId.matches(request.auth.uid + '_.*') ||
          resource.data.userId == request.auth.uid
        );
      allow list: if signedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.petId is string &&
        favoriteId == request.auth.uid + '_' + request.resource.data.petId &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.ownerId != request.auth.uid &&
        request.resource.data.purpose == 'adoption' &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.purpose == 'adoption' &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.isActive == true &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.status in ['published', 'active'] &&
        (
          !('adoptionStatus' in
            get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data) ||
          get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
            .data.adoptionStatus == 'active'
        );
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /listingViews/{viewId} {
      allow get: if signedIn() &&
        (
          viewId.matches('.*_' + request.auth.uid) ||
          resource.data.viewerId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        );
      allow list: if signedIn() &&
        (resource.data.viewerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.viewerId == request.auth.uid &&
        request.resource.data.petId is string &&
        viewId == request.resource.data.petId + '_' + request.auth.uid &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.ownerId != request.auth.uid &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.purpose == 'adoption';
    }

    match /adoptionRequests/{requestId} {
      allow get: if signedIn() &&
        (
          requestId.matches('.*_' + request.auth.uid) ||
          isAdoptionRequestParty(resource.data)
        );
      allow list: if isAdoptionRequestParty(resource.data);
      allow create: if signedIn() &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.ownerId != request.auth.uid &&
        request.resource.data.petId is string &&
        (
          (
            requestId == request.resource.data.petId + '_' + request.auth.uid &&
            get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
              .data.get('listingCycleId', '') == '' &&
            get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
              .data.get('returnedFromAdoptionRequestId', '') == ''
          ) ||
          (
            request.resource.data.listingCycleId is string &&
            (
              request.resource.data.listingCycleId ==
                get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
                  .data.get('listingCycleId', '') ||
              (
                get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
                  .data.get('listingCycleId', '') == '' &&
                request.resource.data.listingCycleId ==
                  get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
                    .data.returnedFromAdoptionRequestId
              )
            ) &&
            requestId == request.resource.data.petId + '_' +
              request.resource.data.listingCycleId + '_' + request.auth.uid
          )
        ) &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.ownerId == request.resource.data.ownerId &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.purpose == 'adoption' &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.isActive == true &&
        (
          !('adoptionStatus' in
            get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data) ||
          get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
            .data.adoptionStatus == 'active'
        ) &&
        get(/databases/$(database)/documents/pets/$(request.resource.data.petId))
          .data.status in ['published', 'active'];
      allow update: if signedIn() &&
        request.resource.data.requestId == resource.data.requestId &&
        request.resource.data.petId == resource.data.petId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.applicantId == resource.data.applicantId &&
        request.resource.data.answers == resource.data.answers &&
        request.resource.data.questionSnapshots ==
          resource.data.questionSnapshots &&
        request.resource.data.petSnapshot == resource.data.petSnapshot &&
        request.resource.data.applicantSnapshot ==
          resource.data.applicantSnapshot &&
        (
          (
            request.auth.uid == resource.data.ownerId &&
            resource.data.status in ['pending', 'under_review'] &&
            (
              request.resource.data.status in ['under_review', 'rejected'] ||
              (
                request.resource.data.status == 'approved' &&
                request.resource.data.conversationId is string &&
                getAfter(
                  /databases/$(database)/documents/pets/$(resource.data.petId)
                ).data.adoptionStatus == 'reserved' &&
                getAfter(
                  /databases/$(database)/documents/pets/$(resource.data.petId)
                ).data.reservedFor == resource.data.applicantId &&
                getAfter(
                  /databases/$(database)/documents/pets/$(resource.data.petId)
                ).data.approvedRequestId == requestId &&
                getAfter(
                  /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
                ).data.requestId == requestId &&
                getAfter(
                  /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
                ).data.purpose == 'adoption'
              )
            )
          ) ||
          (
            request.auth.uid == resource.data.applicantId &&
            resource.data.status in ['pending', 'under_review'] &&
            request.resource.data.status == 'withdrawn'
          ) ||
          (
            resource.data.status == 'approved' &&
            isAdoptionRequestParty(resource.data) &&
            request.resource.data.status == 'completed' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'completedAt',
                'updatedAt',
                'outcome',
                'returnRequestId',
                'returnCompletedAt',
                'reviewsEnabled'
              ]) &&
            (
              !('outcome' in request.resource.data) ||
              (
                request.resource.data.outcome == 'returned' &&
                request.resource.data.reviewsEnabled == false &&
                getAfter(
                  /databases/$(database)/documents/conversations/$(resource.data.conversationId)
                ).data.status == 'returned'
              )
            )
          )
        );
    }

    match /breedingTransactions/{transactionId} {
      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data) &&
        request.resource.data.matchId == transactionId;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn() &&
        (resource.data.isPublished == true ||
         resource.data.reviewerId == request.auth.uid ||
         resource.data.reviewedUserId == request.auth.uid ||
         request.time >= resource.data.visibleAfter);
      allow create: if signedIn() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.reviewedUserId != request.auth.uid &&
        request.resource.data.reviewId == reviewId &&
        reviewId == request.resource.data.matchId + '_' + request.auth.uid &&
        (
          (
            request.resource.data.purpose == 'breeding' &&
            get(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
              .data.status in ['completed', 'auto_completed'] &&
            request.auth.uid in
              get(/databases/$(database)/documents/matches/$(request.resource.data.matchId))
                .data.ownerIds
          ) ||
          (
            request.resource.data.purpose == 'adoption' &&
            get(/databases/$(database)/documents/conversations/$(request.resource.data.matchId))
              .data.status == 'completed' &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(request.resource.data.matchId))
                .data.participantIds
          )
        );
      allow update: if signedIn() &&
        (
          (
            resource.data.purpose == 'breeding' &&
            request.auth.uid in
              get(/databases/$(database)/documents/matches/$(resource.data.matchId))
                .data.ownerIds
          ) ||
          (
            resource.data.purpose == 'adoption' &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(resource.data.matchId))
                .data.participantIds
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPublished', 'publishedAt']);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.recipientId == request.auth.uid;
      allow create: if signedIn();
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'readAt']);
    }
  }
}
